<div class="wrap">
  <% var isTagsIndex = !page.tag && !page.category && !is_archive() && page.path.indexOf('tags') === 0; %>
  <% var isCatsIndex = !page.tag && !page.category && !is_archive() && page.path.indexOf('categories') === 0; %>

  <% if (page.tag) { %>
  <h1 class="page-title">标签：<%= page.tag %></h1>
  <% } else if (page.category) { %>
  <h1 class="page-title">分类：<%= page.category %></h1>
  <% } else if (isTagsIndex) { %>
  <h1 class="page-title">标签</h1>
  <% } else if (isCatsIndex) { %>
  <h1 class="page-title">分类</h1>
  <% } else { %>
  <h1 class="page-title">归档</h1>
  <% } %>

  <% if (isTagsIndex || isCatsIndex) { %>
  <% var items = isTagsIndex ? site.tags : site.categories; %>
  <div class="cloud">
    <% items.each(function(item){ %>
    <a class="chip chip-lg" href="<%- url_for(item.path) %>"><%= item.name %><span class="chip-count"><%= item.posts.length %></span></a>
    <% }); %>
  </div>
  <% } else { %>
  <% var lastYear = null; %>
  <% page.posts.each(function(post){ %>
  <% var y = date(post.date, 'YYYY'); %>
  <% if (y !== lastYear) { %>
  <% if (lastYear !== null) { %></ul><% } %>
  <% lastYear = y; %>
  <h2 class="arc-year"><%= y %></h2>
  <ul class="arc-list">
    <% } %>
    <li class="arc-item">
      <span class="arc-date"><%= date(post.date, 'MM-DD') %></span>
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </li>
  <% }); %>
  <% if (lastYear !== null) { %></ul><% } %>
  <%- paginator({ prev_text: '上一页', next_text: '下一页', mid_size: 1 }) %>
  <% } %>
</div>
