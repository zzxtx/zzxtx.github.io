<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f8fbfd">
<title><% if (page.title && !is_home()) { %><%= page.title %> | <% } %><%= config.title %></title>
<%- open_graph({ type: is_post() ? 'article' : 'website' }) %>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2214%22 fill=%22%23185fa5%22/><path d=%22M18 22l-8 10 8 10M46 22l8 10-8 10M37 16L27 48%22 fill=%22none%22 stroke=%22white%22 stroke-width=%225%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/></svg>">
<link rel="stylesheet" href="<%- url_for('css/style.css') %>">
<script>(function(){var t=null;try{t=localStorage.getItem('theme')}catch(e){}if(!t){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-theme',t)})();</script>
</head>
<body class="<%= is_home() ? 'home-page' : (is_post() ? 'post-page' : 'inner-page') %>">
<div class="reading-progress" id="reading-progress"></div>
<header class="site-nav">
  <div class="nav-inner">
    <a class="logo" href="<%- url_for('/') %>" aria-label="返回首页"><span class="logo-mark"></span><%= config.author || 'blog' %><span class="logo-path"> / lab</span></a>
    <button class="nav-toggle icon-btn" id="nav-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="nav-links">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav class="nav-links" id="nav-links" aria-label="主导航">
      <% for (var name in theme.menu) { %>
      <% var mp = theme.menu[name]; var hashAt = mp.indexOf('#'); var anchored = hashAt !== -1; var act = (mp === '/' ? is_home() : (!anchored && is_current(mp))); %>
      <a href="<%- url_for(mp) %>"<% if (anchored) { %> data-nav-hash="<%= mp.slice(hashAt + 1) %>"<% } %><% if (mp === '/') { %> data-nav-root="1"<% } %><% if (act) { %> class="active"<% } %>><%= name %></a>
      <% } %>
    </nav>
    <% if (!theme.search || theme.search.enable !== false) { %>
    <button class="search-open nav-action" id="search-open" type="button" aria-label="搜索文章" title="搜索文章">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <span>搜索</span><kbd><%= (theme.search && theme.search.shortcut) || '/' %></kbd>
    </button>
    <% } %>
    <button class="theme-toggle icon-btn" id="theme-toggle" type="button" aria-label="切换亮暗模式" title="切换亮暗模式">
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>
<main class="site-main">
<%- body %>
</main>
<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <strong><%= config.author %> / lab</strong>
      <% if (theme.footer && theme.footer.motto) { %><span><%= theme.footer.motto %></span><% } %>
    </div>
    <div class="footer-links">
      <% if (theme.social) { for (var sname in theme.social) { %><a href="<%= theme.social[sname] %>" target="_blank" rel="noopener"><%= sname %></a><% } } %>
      <% if (theme.footer && theme.footer.powered) { %><a href="https://hexo.io" target="_blank" rel="noopener">Hexo</a><% } %>
      <span>© <%= (theme.footer && theme.footer.since) ? theme.footer.since + '–' : '' %><%= new Date().getFullYear() %></span>
    </div>
  </div>
</footer>
<button class="back-top icon-btn" id="back-top" type="button" aria-label="返回顶部" title="返回顶部">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
<% if (!theme.search || theme.search.enable !== false) { %>
<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title" data-max-results="<%= (theme.search && theme.search.max_results) || 8 %>" data-shortcut="<%= (theme.search && theme.search.shortcut) || '/' %>">
  <div class="search-head">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    <label class="sr-only" id="search-title" for="search-input">搜索文章</label>
    <input id="search-input" type="search" autocomplete="off" placeholder="搜索标题、内容或标签…">
    <button class="search-close" id="search-close" type="button">Esc</button>
  </div>
  <div class="search-results" id="search-results"><p class="search-empty">输入关键词开始搜索</p></div>
</dialog>
<%
var searchPosts = site.posts.toArray().map(function(post) {
  var tags = post.tags && post.tags.toArray ? post.tags.toArray().map(function(tag) { return tag.name; }) : [];
  return {
    title: post.title,
    url: url_for(post.path),
    date: date(post.date, 'YYYY-MM-DD'),
    tags: tags,
    text: strip_html(post.content || '').replace(/\s+/g, ' ').trim()
  };
});
%>
<script id="search-data" type="application/json"><%- JSON.stringify(searchPosts).replace(/</g, '\\u003c') %></script>
<% } %>
<script src="<%- url_for('js/main.js') %>"></script>
</body>
</html>
