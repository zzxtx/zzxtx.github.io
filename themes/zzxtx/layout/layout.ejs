<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><% if (page.title && !is_home()) { %><%= page.title %> | <% } %><%= config.title %></title>
<% if (config.description) { %><meta name="description" content="<%= config.description %>"><% } %>
<%- open_graph() %>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="<%- url_for('css/style.css') %>">
<script>(function(){var t=null;try{t=localStorage.getItem('theme')}catch(e){}if(!t){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-theme',t)})();</script>
</head>
<body>
<div class="reading-progress" id="reading-progress"></div>

<header class="site-nav">
  <div class="nav-inner">
    <a class="logo" href="<%- url_for('/') %>">&lt;<%= config.author || 'blog' %> /&gt;</a>
    <nav class="nav-links">
      <% for (var name in theme.menu) { %>
      <% var mp = theme.menu[name]; var act = (mp === '/' ? is_home() : is_current(mp)); %>
      <a href="<%- url_for(mp) %>"<% if (act) { %> class="active"<% } %>><%= name %></a>
      <% } %>
    </nav>
    <button class="theme-toggle" id="theme-toggle" aria-label="切换亮暗模式" title="切换亮暗模式">
      <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>

<main class="site-main">
<%- body %>
</main>

<footer class="site-footer">
  <p>© <%= (theme.footer && theme.footer.since) ? theme.footer.since + ' - ' : '' %><%= new Date().getFullYear() %> <%= config.author %></p>
  <p class="footer-links">
    <% if (theme.social) { for (var sname in theme.social) { %>
    <a href="<%= theme.social[sname] %>" target="_blank" rel="noopener"><%= sname %></a>
    <% } } %>
    <% if (theme.footer && theme.footer.powered) { %><span>由 <a href="https://hexo.io" target="_blank" rel="noopener">Hexo</a> 驱动</span><% } %>
  </p>
</footer>

<button class="back-top" id="back-top" aria-label="返回顶部" title="返回顶部">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>

<script src="<%- url_for('js/main.js') %>"></script>
</body>
</html>
