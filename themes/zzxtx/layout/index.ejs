<% var firstPage = !page.current || page.current === 1; %>
<%# 首页改版：hero 与「精选项目」板块已移除，首页只保留欢迎语 + 文章列表 %>

<section class="home-section home-shell logs-section" id="logs">
  <% if (firstPage) { %>
  <p class="welcome-line"><%= (theme.welcome && theme.welcome.text) || config.description %></p>
  <% } %>
  <header class="section-head">
    <div><p class="eyebrow">RECENT POSTS</p><h2><%= firstPage ? '最近博客' : '更多文章' %></h2></div>
    <% if (firstPage) { %><span class="log-count"><%= date(new Date(), 'YYYY') %> / <%= site.posts.length %> 篇</span><% } %>
  </header>
  <% if (page.posts.length) { %>
  <div class="log-list">
    <% page.posts.each(function(post) { %>
    <% var exc = strip_html(post.excerpt || post.content).replace(/^\s+/, '').replace(/\s+/g, ' ').substring(0, 100); %>
    <article class="log-item">
      <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><span><%= date(post.date, 'MM.DD') %></span><%= date(post.date, 'YYYY') %></time>
      <div class="log-body">
        <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
        <p><%= exc %><% if (exc.length >= 100) { %>…<% } %></p>
        <% if (post.tags && post.tags.length) { %><div class="tag-row"><% post.tags.each(function(tag) { %><a class="chip" href="<%- url_for(tag.path) %>"><%= tag.name %></a><% }); %></div><% } %>
      </div>
      <a class="log-arrow" href="<%- url_for(post.path) %>" aria-label="阅读《<%= post.title %>》">→</a>
    </article>
    <% }); %>
  </div>
  <div class="logs-footer">
    <span>按年份、主题或项目继续探索</span>
    <a href="<%- url_for('/archives/') %>">查看全部日志 <span aria-hidden="true">→</span></a>
  </div>
  <%- paginator({ prev_text: '上一页', next_text: '下一页', mid_size: 1 }) %>
  <% } else { %><p class="empty">实验台暂时是空的，先去写一篇记录吧。</p><% } %>
</section>

<% if (firstPage && (site.tags.length || site.categories.length)) { %>
<section class="home-section home-shell explore-section">
  <header class="section-head"><div><p class="eyebrow">EXPLORE</p><h2>探索主题</h2></div></header>
  <div class="explore-grid">
    <% site.categories.sort('name').each(function(category) { %><a href="<%- url_for(category.path) %>"><span>分类</span><strong><%= category.name %></strong><em><%= category.posts.length %> 篇</em></a><% }); %>
    <% site.tags.toArray().sort(function(a, b) { return a.name.localeCompare(b.name); }).slice(0, 8).forEach(function(tag) { %><a href="<%- url_for(tag.path) %>"><span>标签</span><strong><%= tag.name %></strong><em><%= tag.posts.length %> 篇</em></a><% }); %>
  </div>
</section>
<% } %>
